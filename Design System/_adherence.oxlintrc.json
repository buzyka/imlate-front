      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|plain|text|circle|round|disabled|loading|icon|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, plain, text, circle, round, disabled, loading, icon, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:default|primary|success|warning|danger|info)$/]",
        "message": "<Button> type must be one of 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info'."
