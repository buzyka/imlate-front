{
  "name": "vue-admin-starter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "knip",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run deps:check && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.4",
    "element-plus": "^2.8.4",
    "pinia": "^2.1.7",
    "vue": "^3.5.46",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.48.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
